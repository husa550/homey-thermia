{
  "id": "com.niklasjohansson.thermia",
  "version": "0.1.1",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": { "en": "Thermia Online", "sv": "Thermia Online" },
  "description": {
    "en": "Smarter comfort from your heat pump.",
    "sv": "Smartare komfort från din värmepump."
  },
  "category": ["climate"],
  "permissions": [],
  "brandColor": "#E4002B",
  "author": { "name": "Niklas Johansson" },
  "homepage": "https://github.com/husa550/homey-thermia",
  "support": "https://github.com/husa550/homey-thermia/issues",
  "bugs": { "url": "https://github.com/husa550/homey-thermia/issues" },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "capabilities": {
    "thermia_status": {
      "type": "string",
      "title": { "en": "Status", "sv": "Driftstatus" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/status.svg"
    },
    "thermia_opmode": {
      "type": "string",
      "title": { "en": "Operation mode", "sv": "Driftläge" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/status.svg"
    },
    "hotwater_status": {
      "type": "boolean",
      "title": { "en": "Hot water", "sv": "Varmvatten" },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/status.svg"
    },
    "hotwater_boost": {
      "type": "boolean",
      "title": { "en": "Hot water boost", "sv": "Varmvattenboost" },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/status.svg"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "operational_status_changed",
        "title": { "en": "Operational status changed", "sv": "Driftstatus ändrades" },
        "tokens": [
          { "name": "status", "type": "string", "title": { "en": "Status", "sv": "Status" }, "example": "no demand" }
        ],
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" }
        ]
      },
      {
        "id": "compressor_hours_above",
        "title": { "en": "Compressor hours exceed", "sv": "Kompressortimmar överstiger" },
        "titleFormatted": { "en": "Compressor hours exceed [[hours]] h", "sv": "Kompressortimmar överstiger [[hours]] h" },
        "tokens": [
          { "name": "hours", "type": "number", "title": { "en": "Hours", "sv": "Timmar" }, "example": 7444 }
        ],
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" },
          { "name": "hours", "type": "number", "min": 0, "step": 100, "placeholder": { "en": "40000", "sv": "40000" } }
        ]
      },
      {
        "id": "hotwater_hours_above",
        "title": { "en": "Hot water hours exceed", "sv": "Varmvattentimmar överstiger" },
        "titleFormatted": { "en": "Hot water hours exceed [[hours]] h", "sv": "Varmvattentimmar överstiger [[hours]] h" },
        "tokens": [
          { "name": "hours", "type": "number", "title": { "en": "Hours", "sv": "Timmar" }, "example": 809 }
        ],
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" },
          { "name": "hours", "type": "number", "min": 0, "step": 100, "placeholder": { "en": "10000", "sv": "10000" } }
        ]
      }
    ],
    "conditions": [
      {
        "id": "operational_status_is",
        "title": { "en": "Operational status !{{is|is not}}", "sv": "Driftstatus !{{är|är inte}}" },
        "titleFormatted": { "en": "Operational status !{{is|is not}} [[status]]", "sv": "Driftstatus !{{är|är inte}} [[status]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" },
          { "name": "status", "type": "text", "placeholder": { "en": "no demand", "sv": "no demand" } }
        ]
      },
      {
        "id": "hotwater_is_on",
        "title": { "en": "Hot water !{{is|is not}} on", "sv": "Varmvatten !{{är|är inte}} på" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_room_temperature",
        "title": { "en": "Set room temperature", "sv": "Sätt rumstemperatur" },
        "titleFormatted": { "en": "Set room temperature to [[temperature]] °C", "sv": "Sätt rumstemperatur till [[temperature]] °C" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" },
          { "name": "temperature", "type": "number", "min": 10, "max": 35, "step": 1, "placeholder": { "en": "21", "sv": "21" } }
        ]
      },
      {
        "id": "set_hotwater",
        "title": { "en": "Turn hot water on/off", "sv": "Slå på/av varmvatten" },
        "titleFormatted": { "en": "Turn hot water [[mode]]", "sv": "Slå [[mode]] varmvattnet" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              { "id": "on", "title": { "en": "on", "sv": "på" } },
              { "id": "off", "title": { "en": "off", "sv": "av" } }
            ]
          }
        ]
      },
      {
        "id": "set_hotwater_boost",
        "title": { "en": "Turn hot water boost on/off", "sv": "Slå på/av varmvattenboost" },
        "titleFormatted": { "en": "Turn hot water boost [[mode]]", "sv": "Slå [[mode]] varmvattenboosten" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermia" },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              { "id": "on", "title": { "en": "on", "sv": "på" } },
              { "id": "off", "title": { "en": "off", "sv": "av" } }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "thermia",
      "name": { "en": "Thermia Heat Pump", "sv": "Thermia värmepump" },
      "class": "thermostat",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "measure_temperature.supply",
        "measure_temperature.return",
        "measure_temperature.brine_in",
        "measure_temperature.brine_out",
        "measure_temperature.hotwater",
        "thermia_status",
        "thermia_opmode",
        "hotwater_status",
        "hotwater_boost"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "title": { "en": "Room temperature (curve)", "sv": "Rumstemperatur (kurva)" },
          "min": 10,
          "max": 35,
          "step": 1
        },
        "measure_temperature": { "title": { "en": "Outdoor temperature", "sv": "Utetemperatur" }, "min": -50, "max": 150, "decimals": 1 },
        "measure_temperature.supply": { "title": { "en": "Supply line", "sv": "Framledning" }, "min": -50, "max": 150, "decimals": 1 },
        "measure_temperature.return": { "title": { "en": "Return line", "sv": "Returledning" }, "min": -50, "max": 150, "decimals": 1 },
        "measure_temperature.brine_in": { "title": { "en": "Brine in", "sv": "Brine in" }, "min": -50, "max": 150, "decimals": 1 },
        "measure_temperature.brine_out": { "title": { "en": "Brine out", "sv": "Brine ut" }, "min": -50, "max": 150, "decimals": 1 },
        "measure_temperature.hotwater": { "title": { "en": "Hot water", "sv": "Varmvatten" }, "min": -50, "max": 150, "decimals": 1 }
      },
      "images": {
        "small": "/drivers/thermia/assets/images/small.png",
        "large": "/drivers/thermia/assets/images/large.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": { "en": "Email", "sv": "E-post" },
            "usernamePlaceholder": "namn@example.com",
            "passwordLabel": { "en": "Password", "sv": "Losenord" }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": { "next": "add_devices" }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ]
}
